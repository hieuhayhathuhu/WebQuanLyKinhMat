<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#122d2b">
  <title>Kính Mắt — Quản lý cửa hàng</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  <script nonce="@ViewBag.CspNonce">window.KINHMAT_BOOTSTRAP = @Html.Raw(ViewBag.BootstrapJson);</script>
  <script src="~/js/config.js" asp-append-version="true" defer></script>
  <script src="~/js/data-service.js" asp-append-version="true" defer></script>
  <script src="~/js/app.js" asp-append-version="true" defer></script>
</head>
<body>
  <a class="skip-link" id="skip-link" href="#main">Chuyển đến nội dung</a>
  <button class="sidebar-scrim" id="sidebar-scrim" aria-label="Đóng menu" hidden></button>
  <aside class="sidebar" id="sidebar" aria-label="Điều hướng chính">
    <a class="brand" href="#overview"><span class="brand-mark" data-icon="glasses"></span><span>KÍNH MẮT<span class="brand-caption">STORE MANAGEMENT</span></span></a>
    <div class="store-switch"><span class="store-avatar" data-icon="store"></span><span>Cửa hàng kính mắt<small>Không gian quản lý</small></span><span class="store-dot"></span></div>
    <nav id="navigation"></nav>
    <div class="sidebar-bottom"><div class="support-card"><span data-icon="sparkles"></span><strong>Mọi thứ trong tầm nhìn.</strong><p>Một nơi cho công việc<br>mỗi ngày của cửa hàng.</p></div><div class="profile"><span class="avatar" id="profile-avatar">NV</span><span class="profile-name"><strong id="profile-name">Nhân viên</strong><small id="profile-role"></small></span><button class="icon-button" id="profile-button" aria-label="Tài khoản của tôi"><span data-icon="people"></span></button></div></div>
  </aside>
  <div class="workspace">
    <header class="topbar"><div class="breadcrumb"><button class="icon-button mobile-menu" id="menu-button" aria-label="Mở menu" aria-expanded="false" aria-controls="sidebar"><span data-icon="menu"></span></button><span class="breadcrumb-store">Không gian làm việc</span><span class="breadcrumb-divider">/</span><strong id="breadcrumb-page">Tổng quan</strong></div><div class="topbar-actions"><span class="today" id="today"></span><button class="icon-button" id="global-search" aria-label="Tìm kiếm toàn bộ"><span data-icon="search"></span></button><button class="icon-button" id="help-button" aria-label="Hướng dẫn sử dụng"><span data-icon="help"></span></button></div></header>
    <div class="mode-strip" id="mode-strip"><span class="mode-dot"></span><span id="session-status">Đang kết nối cửa hàng…</span><button id="refresh-data">Làm mới dữ liệu ↻</button></div>
    <main id="main" tabindex="-1" aria-busy="false"></main>
    <footer class="footer"><span>KÍNH MẮT <span class="footer-dot">·</span> Quản lý gọn gàng. Tập trung bán hàng.</span><span id="footer-mode">Quản lý cửa hàng</span></footer>
  </div>
  <dialog id="modal" aria-labelledby="modal-title"><div class="modal-heading"><div><span class="eyebrow">KÍNH MẮT</span><h2 id="modal-title"></h2></div><button class="icon-button" id="close-modal" aria-label="Đóng hộp thoại"><span data-icon="close"></span></button></div><div id="modal-body"></div></dialog>
  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>
